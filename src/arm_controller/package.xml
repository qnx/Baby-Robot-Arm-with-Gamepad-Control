<?xml version="1.0"?>
<package format="3">
  <name>arm_controller</name>
  <version>1.0.1</version>
  <description>Controls a five-joint arm and separate gripper through a PCA9685 driver.</description>
  <maintainer email="nirajpatel@qnx.com">user</maintainer>
  <license>Apache License 2.0</license>
  <!-- PCA9685.py retains the MIT notice from the Adafruit-derived driver. -->
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-smbus</exec_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
